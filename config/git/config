##
# symlink this to ~/.config/git/config

[user]
	name = Marco Nicosia
	email = marco-github@escape.org
[core]
	editor = emacs
	ignorecase = true
	sshCommand = ssh -i ~/.ssh/marco-github -o IdentitiesOnly=yes
[credential "https://github.com/menicosia"]
	username = menicosia
[credential "https://github.com/pm-practices/pm-blog"]
	username = menicosia
[credential]
	helper = cache --timeout=86400
[push]
	default = simple
[pull]
	rebase = true
# [credential "https://github.com"]
# 	helper = 
# 	helper = !/usr/bin/gh auth git-credential
# [credential "https://gist.github.com"]
# 	helper = 
# 	helper = !/usr/bin/gh auth git-credential

## Defaul identity (personal) stays in [user] above
# Anything under ~/src/amd/ uses this work identity instead
[includeIf "gitdir:~/src/amd/"]
	path = ~/dotfiles/amd/git-config
